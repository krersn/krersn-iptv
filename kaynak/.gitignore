!/KrersnStudio.spec
!/requirements.txt
!/derle.ps1
!/kurulum.iss
!/sifirla.ps1
!/yukle.ps1
!/surum_yayinla.ps1
!/krersn.ico
!/krersn.png
!/README.md
!/LICENSE
__pycache__/
